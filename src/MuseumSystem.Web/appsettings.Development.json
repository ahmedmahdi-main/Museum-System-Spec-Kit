{
  "ConnectionStrings": {
    "MuseumDatabase": "Host=localhost;Port=5432;Database=museum_system_dev;Username=museum_app;Password=CHANGE_ME"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Photography": {
    "Storage": {
      "Provider": "Minio",
      "Endpoint": "http://localhost:9000",
      "BucketName": "museum-artifact-images-dev",
      "Region": "us-east-1",
      "UseTls": false
    },
    "Uploads": {
      "MaximumOriginalBytes": 20971520
    },
    "Derivatives": {
      "Thumbnail": {
        "MaxWidth": 320,
        "MaxHeight": 320,
        "JpegQuality": 82
      },
      "Preview": {
        "MaxWidth": 1600,
        "MaxHeight": 1600,
        "JpegQuality": 86
      }
    },
    "Idempotency": {
      "RetentionDays": 14
    }
  }
}
