@page "/artifacts/{ArtifactId:guid}"
@attribute [Authorize(Policy = PermissionNames.ArtifactsView)]
@rendermode InteractiveServer
@inject ArtifactReadUseCases ArtifactReadUseCases
@inject ArtifactWriteUseCases ArtifactWriteUseCases
@inject MovementHistoryUseCase MovementHistoryUseCase
@inject ViewArtifactImagesUseCase ViewImagesUseCase
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>تفاصيل القطعة</PageTitle>

@if (artifact is null)
{
    <div class="detail-page">
        <section class="page-header">
            <div>
                <p class="eyebrow">سجل القطع</p>
                <h1>القطعة غير موجودة</h1>
                <p>لم نعثر على سجل القطعة. قد تكون محذوفة أو أن الرابط غير صحيح.</p>
            </div>
            <div class="page-header-actions">
                <a class="btn-secondary" href="/artifacts">العودة إلى البحث</a>
            </div>
        </section>
    </div>
}
else
{
    <div class="detail-page">
        <section class="page-header">
            <div>
                <p class="eyebrow">سجل القطع</p>
                <h1><span class="ref ref-lead">@artifact.MuseumNumber</span></h1>
                <p>@artifact.BasicDescription</p>
            </div>
            <div class="page-header-actions">
                <a class="btn-secondary" href="/artifacts">العودة إلى البحث</a>
            </div>
        </section>

        <div class="artifact-state" aria-label="الحالة التشغيلية الحالية للقطعة">
            <div class="artifact-state-item critical">
                <span>الحالة الحالية</span>
                <strong><span class="badge-status @CurrentStatusClass(artifact.CurrentStatus)">@CurrentStatusText(artifact.CurrentStatus)</span></strong>
            </div>
            <div class="artifact-state-item critical">
                <span>الموقع الحالي</span>
                <strong>@(artifact.CurrentLocationName ?? "لا يوجد موقع محدد")</strong>
            </div>
            <div class="artifact-state-item">
                <span>الحيازة الحالية</span>
                <strong>@CurrentHolderText</strong>
            </div>
        </div>

        <div class="detail-layout">
            <main class="detail-main">
                <section class="page-section">
                    <div class="section-header">
                        <div>
                            <p class="eyebrow">الحركة</p>
                            <h2>سجل الحركة</h2>
                            <p>تسلسل التسليم والاسترجاع المرتبط بهذه القطعة.</p>
                        </div>
                    </div>
                    <div class="section-body">
                        @if (movementHistory.Count == 0)
                        {
                            <div class="empty-state">
                                <strong>لا توجد حركات مسجلة بعد.</strong>
                                <span>ستظهر حركات التسليم والاسترجاع هنا عند تسجيلها.</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-wrap">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>النوع</th>
                                            <th>الحيازة</th>
                                            <th>موقع الإرجاع</th>
                                            <th>الوقت</th>
                                            <th>الملاحظة</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var movement in movementHistory)
                                        {
                                            <tr>
                                                <td>@MovementTypeText(movement.MovementType)</td>
                                                <td>@MovementHolderText(movement)</td>
                                                <td>@(movement.ReturnLocationName ?? "-")</td>
                                                <td>@movement.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                                <td>@(movement.Note ?? movement.Purpose ?? "-")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </section>

                @if (canViewPhotography)
                {
                    <section class="page-section">
                        <div class="section-header">
                            <div>
                                <p class="eyebrow">التصوير</p>
                                <h2>صور القطعة</h2>
                                <p>لمحة سريعة عن صور القطعة المتاحة عبر حدود التطبيق.</p>
                            </div>
                            @if (photographyGallery is not null)
                            {
                                <div class="page-header-actions">
                                    <a class="btn-secondary compact" href="@PhotographyGalleryHref">عرض جميع الصور</a>
                                </div>
                            }
                        </div>
                        <div class="section-body">
                            @if (photographyGallery is null)
                            {
                                <div class="empty-state">
                                    <strong>@(photographyMessage ?? "تعذر تحميل صور القطعة حاليًا.")</strong>
                                </div>
                            }
                            else if (photographyGallery.State == ArtifactImageGalleryState.NoImages)
                            {
                                <div class="empty-state">
                                    <strong>لا توجد صور متاحة لهذه القطعة.</strong>
                                </div>
                            }
                            else
                            {
                                <div class="photography-strip" aria-label="لمحة عن صور القطعة">
                                    @foreach (var image in photographyGallery.Images.Take(4))
                                    {
                                        <div class="photography-strip-item">
                                            @if (CanShowRendition(image.Thumbnail))
                                            {
                                                <img src="@ImageSource(image.Thumbnail.Access!)" alt="@ImageAlt(image)" />
                                            }
                                            else
                                            {
                                                <span class="media-unavailable" role="status">الصورة مسجلة ولكن الملف غير متاح حاليًا.</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }
            </main>

            <aside class="detail-aside">
                <section class="page-section">
                    <div class="section-header">
                        <div>
                            <p class="eyebrow">التعريف</p>
                            <h2>بيانات القطعة</h2>
                        </div>
                    </div>
                    <div class="section-body">
                        <dl class="details-list">
                            <dt>رمز الفئة</dt><dd>@artifact.CategoryCode</dd>
                            <dt>رقم القطعة داخل الفئة</dt><dd>@artifact.ItemNumber</dd>
                            <dt>الحالة</dt><dd>@CurrentStatusText(artifact.CurrentStatus)</dd>
                            <dt>الموقع الحالي</dt><dd>@(artifact.CurrentLocationName ?? "لا يوجد موقع محدد")</dd>
                            <dt>الحيازة الحالية</dt><dd>@CurrentHolderText</dd>
                            <dt>معرف النظام</dt><dd><code>@artifact.ArtifactId</code></dd>
                        </dl>
                    </div>
                </section>

                <section class="page-section">
                    <div class="section-header">
                        <div>
                            <p class="eyebrow">الوصف</p>
                            <h2>تحديث البيانات الأساسية</h2>
                        </div>
                    </div>
                    <div class="section-body">
                        @if (!string.IsNullOrWhiteSpace(message))
                        {
                            <div class="status-message">@message</div>
                        }

                        <EditForm Model="this" OnSubmit="UpdateAsync" FormName="update-artifact-basic-info">
                            <label>
                                <span>الوصف الأساسي</span>
                                <InputTextArea @bind-Value="basicDescription" class="form-control" />
                            </label>
                            <div class="form-actions">
                                <button type="submit" class="btn-primary">حفظ التعديل</button>
                            </div>
                        </EditForm>
                    </div>
                </section>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ArtifactId { get; set; }

    private ArtifactDetailsDto? artifact;
    private string basicDescription = string.Empty;
    private string? message;
    private List<MovementHistoryDto> movementHistory = [];
    private bool canViewPhotography;
    private ArtifactImageGalleryDto? photographyGallery;
    private string? photographyMessage;

    private string CurrentHolderText => string.IsNullOrWhiteSpace(artifact?.CurrentHolderName)
        ? "لا توجد حيازة خارجية"
        : $"{artifact.CurrentHolderType}: {artifact.CurrentHolderName}";

    private string PhotographyGalleryHref => $"/photography/artifacts/{ArtifactId}";

    protected override async Task OnParametersSetAsync()
    {
        artifact = await ArtifactReadUseCases.GetArtifactDetails(ArtifactId);
        basicDescription = artifact?.BasicDescription ?? string.Empty;
        movementHistory = (await MovementHistoryUseCase.GetMovementHistory(ArtifactId)).ToList();

        if (artifact is not null)
        {
            await LoadPhotographyAsync();
        }
    }

    private async Task LoadPhotographyAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canViewPhotography = (await AuthorizationService.AuthorizeAsync(state.User, PermissionNames.PhotographyView)).Succeeded;

        if (!canViewPhotography)
        {
            photographyGallery = null;
            photographyMessage = null;
            return;
        }

        var result = await ViewImagesUseCase.ViewArtifactImages(new ViewArtifactImagesQuery(ArtifactId));
        photographyGallery = result.Succeeded ? result.Value : null;
        photographyMessage = result.Succeeded ? null : PhotographyFailureMessage(result);
    }

    private async Task UpdateAsync()
    {
        var result = await ArtifactWriteUseCases.UpdateArtifactBasicInfo(new UpdateArtifactBasicInfoRequest(ArtifactId, basicDescription));
        message = result.Succeeded ? "تم حفظ التعديل." : string.Join(" ", result.ValidationIssues.Select(i => i.Message));
        artifact = result.Value ?? artifact;
    }

    private static string CurrentStatusText(ArtifactCurrentStatus status) => status switch
    {
        ArtifactCurrentStatus.InStorage => "داخل المخزن",
        ArtifactCurrentStatus.OutOfStorage => "خارج المخزن",
        _ => status.ToString()
    };

    private static string CurrentStatusClass(ArtifactCurrentStatus status) => status switch
    {
        ArtifactCurrentStatus.InStorage => "badge-storage",
        ArtifactCurrentStatus.OutOfStorage => "badge-out",
        _ => string.Empty
    };

    private static string MovementTypeText(MovementType movementType) => movementType == MovementType.Delivery ? "تسليم" : "استرجاع";

    private static string MovementHolderText(MovementHistoryDto movement) => movement.MovementType == MovementType.Return
        ? "المخزن"
        : $"{movement.RecipientType}: {movement.RecipientName}";

    private static bool CanShowRendition(PhotographyGalleryRenditionDto rendition) =>
        rendition.Availability == PhotographyImageRenditionAvailability.Available && rendition.Access is not null;

    private static string ImageSource(PhotographyImageAccessReferenceDto access) =>
        $"/photography/images/{access.ArtifactImageId}/{access.Rendition.ToString().ToLowerInvariant()}";

    private string ImageAlt(PhotographyGalleryImageDto image)
    {
        var caption = string.IsNullOrWhiteSpace(image.Caption) ? PurposeText(image.Purpose) : image.Caption;
        return $"صورة للقطعة {artifact?.MuseumNumber} — {caption}";
    }

    private static string PurposeText(PhotographyPurpose purpose) => purpose switch
    {
        PhotographyPurpose.GeneralDocumentation => "توثيق عام",
        PhotographyPurpose.PreMaintenance => "قبل الصيانة",
        PhotographyPurpose.DuringMaintenance => "أثناء الصيانة",
        PhotographyPurpose.PostMaintenance => "بعد الصيانة",
        _ => purpose.ToString()
    };

    private static string PhotographyFailureMessage(UseCaseResult<ArtifactImageGalleryDto> result)
    {
        var code = result.ValidationIssues.FirstOrDefault()?.Code;
        return code switch
        {
            "Artifact.NotFound" => "لم يتم العثور على القطعة.",
            "Photography.PermissionDenied" => "لا تملك صلاحية عرض صور القطعة.",
            _ => "تعذر تحميل صور القطعة حاليًا."
        };
    }
}
