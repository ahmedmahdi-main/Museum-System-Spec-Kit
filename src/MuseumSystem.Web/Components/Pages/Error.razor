@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>خطأ</PageTitle>

<section class="page-header">
    <p class="eyebrow">الخطأ</p>
    <h1>لم يكتمل الطلب</h1>
    <p>توقف الإجراء قبل أن يُحفظ، فلم تتغير أي بيانات. أعد المحاولة، وإن تكرر الخطأ فأبلغ الإدارة برقم الطلب أدناه.</p>
</section>

<section class="page-section">
    <div class="form-actions">
        <a class="btn-primary" href="/">العودة للرئيسية</a>
    </div>

    @if (ShowRequestId)
    {
        <p class="muted">رقم الطلب: <code>@RequestId</code></p>
    }
</section>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
