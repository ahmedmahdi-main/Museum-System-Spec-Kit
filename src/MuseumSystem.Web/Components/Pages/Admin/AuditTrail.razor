@page "/admin/audit"
@attribute [Authorize(Policy = PermissionNames.AuditView)]
@rendermode InteractiveServer
@inject AuditTrailUseCase AuditTrailUseCase

<PageTitle>سجل التدقيق</PageTitle>

<section class="page-header">
    <p class="eyebrow">الإدارة</p>
    <h1>سجل التدقيق</h1>
    <p>العمليات الحساسة في النظام، مرتبة من الأحدث، مع من نفّذها ومتى.</p>
</section>

<section class="page-section">
    @if (entries.Count == 0)
    {
        <div class="status-message">لا توجد عمليات مسجلة بعد.</div>
    }
    else
    {
    <div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>الوقت</th>
                <th>الإجراء</th>
                <th>الوحدة</th>
                <th>الكيان</th>
                <th>الملخص</th>
                <th>التغيير</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in entries)
            {
                var actionDisplay = AuditDisplayText.Action(entry.ActionName);
                var moduleDisplay = AuditDisplayText.Module(entry.ModuleName);
                var entityDisplay = AuditDisplayText.Entity(entry.EntityName);
                var summaryDisplay = AuditDisplayText.Summary(entry.Summary);
                var changeDisplay = AuditDisplayText.Summary(entry.ChangeSummary);

                <tr>
                    <td>@entry.OccurredAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <span class="audit-primary">@actionDisplay</span>
                        @if (AuditDisplayText.HasDisplayValue(entry.ActionName, actionDisplay))
                        {
                            <code class="audit-code">@entry.ActionName</code>
                        }
                    </td>
                    <td>
                        <span class="audit-primary">@moduleDisplay</span>
                        @if (AuditDisplayText.HasDisplayValue(entry.ModuleName, moduleDisplay))
                        {
                            <code class="audit-code">@entry.ModuleName</code>
                        }
                    </td>
                    <td>
                        <span class="audit-primary">@entityDisplay</span>
                        @if (AuditDisplayText.HasDisplayValue(entry.EntityName, entityDisplay))
                        {
                            <code class="audit-code">@entry.EntityName</code>
                        }
                    </td>
                    <td>
                        <span class="audit-primary">@summaryDisplay</span>
                        @if (AuditDisplayText.HasDisplayValue(entry.Summary, summaryDisplay))
                        {
                            <span class="audit-secondary">@entry.Summary</span>
                        }
                    </td>
                    <td>
                        <span class="audit-primary">@changeDisplay</span>
                        @if (AuditDisplayText.HasDisplayValue(entry.ChangeSummary, changeDisplay))
                        {
                            <span class="audit-secondary">@entry.ChangeSummary</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    }
</section>

@code {
    private List<AuditEntryDto> entries = [];

    protected override async Task OnInitializedAsync()
    {
        entries = (await AuditTrailUseCase.ListAuditEntries()).ToList();
    }
}
