@page "/documentation/templates"
@attribute [Authorize(Policy = PermissionNames.DocumentationTemplatesView)]
@rendermode InteractiveServer
@inject TemplateQueryUseCases TemplateQueries
@inject CreateDocumentationTemplateUseCase CreateTemplateUseCase
@inject CreateTemplateVersionDraftUseCase CreateDraftUseCase
@inject ActivateTemplateVersionUseCase ActivateUseCase
@inject RetireTemplateVersionUseCase RetireUseCase
@inject CategoryUseCases CategoryUseCases
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>قوالب التوثيق</PageTitle>

<section class="page-header">
    <p class="eyebrow">التوثيق</p>
    <h1>قوالب التوثيق</h1>
    <p>إدارة قوالب الفئات وإصداراتها النشطة والمسودات.</p>
</section>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="status-message">@message</div>
}

@if (canManage)
{
    <section class="page-section">
        <h2>إنشاء قالب جديد</h2>
        <EditForm Model="this" OnSubmit="CreateTemplateAsync" FormName="create-documentation-template">
            <div class="form-grid">
                <label>
                    <span>فئة القطعة</span>
                    <InputSelect @bind-Value="selectedCategoryId" class="form-control">
                        <option value="">اختر الفئة</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.CategoryId">@category.CategoryCode - @category.NameArabic</option>
                        }
                    </InputSelect>
                </label>
                <label>
                    <span>اسم القالب</span>
                    <InputText @bind-Value="templateName" class="form-control" />
                </label>
                <label>
                    <span>الوصف</span>
                    <InputText @bind-Value="templateDescription" class="form-control" />
                </label>
                <div class="form-actions">
                    <button type="submit" class="btn-primary">إنشاء القالب</button>
                </div>
            </div>
        </EditForm>
    </section>
}

<section class="page-section">
    <h2>القوالب الحالية</h2>

    @if (templates.Count == 0)
    {
        <div class="status-message">لا توجد قوالب توثيق بعد.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>الفئة</th>
                        <th>القالب</th>
                        <th>الإصدارات</th>
                        <th>النشط</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var template in templates)
                    {
                        <tr>
                            <td>@template.ArtifactCategoryCode - @template.ArtifactCategoryName</td>
                            <td>
                                <strong>@template.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(template.Description))
                                {
                                    <div class="muted">@template.Description</div>
                                }
                            </td>
                            <td>
                                <div class="inline-actions">
                                    @foreach (var version in template.Versions)
                                    {
                                        <a class="badge-status @StatusClass(version.Status)" href="@DetailsHref(version.DocumentationTemplateVersionId)">
                                            إصدار @version.VersionNumber - @VersionStatusText(version.Status)@(version.IsUsed ? " - مستخدم" : string.Empty)
                                        </a>
                                    }
                                </div>
                            </td>
                            <td>@(template.ActiveVersion is null ? "لا يوجد إصدار نشط" : $"إصدار {template.ActiveVersion.VersionNumber}")</td>
                            <td>
                                @if (canManage)
                                {
                                    <div class="template-actions">
                                        <div class="action-family">
                                            <span class="action-group-label">إجراءات القالب</span>
                                            <div class="inline-actions">
                                                <button type="button" class="btn-primary compact" @onclick="() => CreateDraftAsync(template.DocumentationTemplateId, null)">مسودة جديدة</button>
                                                @if (template.LatestVersion is not null)
                                                {
                                                    <button type="button" class="btn-secondary compact" @onclick="() => CreateDraftAsync(template.DocumentationTemplateId, template.LatestVersion.DocumentationTemplateVersionId)">نسخ آخر إصدار</button>
                                                }
                                            </div>
                                        </div>
                                        <div class="action-family">
                                            <span class="action-group-label">إجراءات الإصدارات</span>
                                            <div class="inline-actions">
                                                @foreach (var version in template.Versions)
                                                {
                                                    @if (version.Status == DocumentationTemplateVersionStatus.Draft)
                                                    {
                                                        <a class="btn-secondary compact" href="@EditorHref(version.DocumentationTemplateVersionId)">تحرير إصدار @version.VersionNumber</a>
                                                        <button type="button" class="btn-secondary compact" @onclick="() => ActivateAsync(version)">تفعيل @version.VersionNumber</button>
                                                    }
                                                    @if (version.Status == DocumentationTemplateVersionStatus.Active)
                                                    {
                                                        <button type="button" class="btn-secondary compact" @onclick="() => RetireAsync(version)">إيقاف إصدار @version.VersionNumber</button>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="muted">عرض فقط</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<CategoryDto> categories = [];
    private List<DocumentationTemplateListItemDto> templates = [];
    private Guid? selectedCategoryId;
    private string templateName = string.Empty;
    private string? templateDescription;
    private string? message;
    private bool canManage;

    protected override async Task OnInitializedAsync()
    {
        categories = (await CategoryUseCases.ListCategories()).ToList();
        selectedCategoryId = categories.FirstOrDefault()?.CategoryId;
        canManage = await IsAuthorizedAsync(PermissionNames.DocumentationTemplatesManage);
        await ReloadAsync();
    }

    private async Task CreateTemplateAsync()
    {
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationTemplatesManage))
        {
            message = "لا تملك صلاحية إدارة قوالب التوثيق.";
            return;
        }

        if (selectedCategoryId is null)
        {
            message = "اختر فئة القطعة قبل إنشاء القالب.";
            return;
        }

        var result = await CreateTemplateUseCase.CreateDocumentationTemplate(new CreateDocumentationTemplateRequest(selectedCategoryId.Value, templateName, templateDescription));
        message = FormatResult(result);
        if (result.Succeeded)
        {
            templateName = string.Empty;
            templateDescription = null;
            await ReloadAsync();
        }
    }

    private async Task CreateDraftAsync(Guid templateId, Guid? sourceVersionId)
    {
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationTemplatesManage))
        {
            message = "لا تملك صلاحية إدارة قوالب التوثيق.";
            return;
        }

        var result = await CreateDraftUseCase.CreateTemplateVersionDraft(new CreateTemplateVersionDraftRequest(templateId, sourceVersionId));
        message = FormatResult(result);
        await ReloadAsync();
    }

    private async Task ActivateAsync(DocumentationTemplateVersionSummaryDto version)
    {
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationTemplatesManage))
        {
            message = "لا تملك صلاحية تفعيل قوالب التوثيق.";
            return;
        }

        var result = await ActivateUseCase.ActivateTemplateVersion(new ActivateTemplateVersionRequest(version.DocumentationTemplateVersionId, version.ConcurrencyToken));
        message = FormatResult(result);
        await ReloadAsync();
    }

    private async Task RetireAsync(DocumentationTemplateVersionSummaryDto version)
    {
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationTemplatesManage))
        {
            message = "لا تملك صلاحية إيقاف قوالب التوثيق.";
            return;
        }

        var result = await RetireUseCase.RetireTemplateVersion(new RetireTemplateVersionRequest(version.DocumentationTemplateVersionId, version.ConcurrencyToken));
        message = result.Succeeded
            ? string.Join(" ", result.Messages.DefaultIfEmpty("تم إيقاف إصدار القالب. قد تبقى الفئة دون إصدار نشط مؤقتاً.").Select(LocalizeMessage))
            : FormatResult(result);
        await ReloadAsync();
    }

    private async Task ReloadAsync() => templates = (await TemplateQueries.ListDocumentationTemplates()).ToList();

    private async Task<bool> IsAuthorizedAsync(string policy)
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return (await AuthorizationService.AuthorizeAsync(state.User, policy)).Succeeded;
    }

    private static string DetailsHref(Guid versionId) => $"documentation/templates/{versionId}";

    private static string EditorHref(Guid versionId) => $"documentation/templates/{versionId}/edit";

    private static string VersionStatusText(DocumentationTemplateVersionStatus status) => status switch
    {
        DocumentationTemplateVersionStatus.Draft => "مسودة",
        DocumentationTemplateVersionStatus.Active => "نشط",
        DocumentationTemplateVersionStatus.Retired => "متوقف",
        _ => status.ToString()
    };

    private static string StatusClass(DocumentationTemplateVersionStatus status) => status switch
    {
        DocumentationTemplateVersionStatus.Draft => "badge-draft",
        DocumentationTemplateVersionStatus.Active => "badge-active",
        DocumentationTemplateVersionStatus.Retired => "badge-retired",
        _ => string.Empty
    };

    private static string FormatResult<T>(UseCaseResult<T> result) =>
        result.Succeeded
            ? string.Join(" ", result.Messages.DefaultIfEmpty("تم الحفظ.").Select(LocalizeMessage))
            : result.ConcurrencyConflict
                ? string.Join(" ", result.Messages.Select(LocalizeMessage))
                : string.Join(" ", result.ValidationIssues.Select(issue => LocalizeMessage(issue.Message)));

    private static string LocalizeMessage(string message)
    {
        if (message.Contains("created", StringComparison.OrdinalIgnoreCase)) return "تم الإنشاء.";
        if (message.Contains("saved", StringComparison.OrdinalIgnoreCase)) return "تم الحفظ.";
        if (message.Contains("activated", StringComparison.OrdinalIgnoreCase)) return "تم تفعيل إصدار القالب.";
        if (message.Contains("retired", StringComparison.OrdinalIgnoreCase)) return "تم إيقاف إصدار القالب.";
        if (message.Contains("Reload and review", StringComparison.OrdinalIgnoreCase)) return "تغيرت البيانات. أعد التحميل وراجع آخر نسخة قبل المتابعة.";
        if (message.Contains("not authorized", StringComparison.OrdinalIgnoreCase)) return "لا تملك الصلاحية المطلوبة.";
        if (message.Contains("Only Draft", StringComparison.OrdinalIgnoreCase)) return "يمكن تحرير إصدارات المسودة فقط.";
        return message;
    }
}
