@page "/documentation/records/{RecordId:guid}/edit"
@attribute [Authorize(Policy = PermissionNames.DocumentationView)]
@rendermode InteractiveServer
@inject GetDocumentationRecordForEditUseCase GetRecordUseCase
@inject SaveDocumentationDraftUseCase SaveDraftUseCase
@inject CompleteDocumentationRecordUseCase CompleteUseCase
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>سجل التوثيق</PageTitle>

<section class="page-header">
    <p class="eyebrow">التوثيق</p>
    <h1>سجل التوثيق</h1>
</section>

<section class="page-section">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-message @(isConflict ? "warning-message" : null)">@message</div>
        @if (isConflict)
        {
            <div class="form-actions">
                <button type="button" class="btn-secondary" @onclick="ReloadLatestRecordAsync">إعادة تحميل أحدث نسخة</button>
            </div>
        }
    }

    @if (record is not null)
    {
        <div class="summary-grid">
            <div class="summary-item">
                <span>رقم المتحف</span>
                <strong>@record.Artifact.MuseumNumber</strong>
            </div>
            <div class="summary-item">
                <span>الوصف</span>
                <strong>@record.Artifact.BasicDescription</strong>
            </div>
            <div class="summary-item">
                <span>القالب</span>
                <strong>@record.TemplateVersion.TemplateName - إصدار @record.TemplateVersion.VersionNumber</strong>
            </div>
            <div class="summary-item">
                <span>الحالة</span>
                <strong>@RecordStatusText(record.Record.Status)</strong>
            </div>
        </div>

        <EditForm Model="values" OnSubmit="SaveDraftAsync" FormName="documentation-record-draft">
            <DynamicDocumentationForm Fields="record.TemplateVersion.Fields" Values="values" IsReadOnly="IsFormReadOnly" />

            @if (record.Record.Status == DocumentationRecordStatus.Draft)
            {
                <div class="form-actions">
                    <button type="submit" class="btn-primary" disabled="@(!record.Actions.CanSaveDraft)">حفظ المسودة</button>
                    <button type="button" class="btn-secondary" disabled="@(!record.Actions.CanComplete)" @onclick="CompleteAsync">إكمال التوثيق</button>
                </div>
            }
            else
            {
                <div class="status-message">السجل مكتمل. تظل القيم المعروضة للقراءة فقط، وتُحفظ أي تصحيحات كمراجعة جديدة.</div>
                <div class="form-actions">
                    @if (canCorrectCompleted)
                    {
                        <a class="btn-primary" href="/documentation/records/@RecordId/correct">تصحيح السجل</a>
                    }
                    @if (canViewHistory)
                    {
                        <a class="btn-secondary" href="/documentation/records/@RecordId/history">سجل المراجعات</a>
                    }
                </div>
            }
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(record.Actions.DraftEditBlockedReason) && record.Record.Status == DocumentationRecordStatus.Draft)
        {
            <p class="muted">@LocalizeMessage(record.Actions.DraftEditBlockedReason)</p>
        }
        @if (!string.IsNullOrWhiteSpace(record.Actions.CompleteBlockedReason) && record.Record.Status == DocumentationRecordStatus.Draft)
        {
            <p class="muted">@LocalizeMessage(record.Actions.CompleteBlockedReason)</p>
        }
    }
</section>

@code {
    [Parameter] public Guid RecordId { get; set; }

    private DocumentationRecordEditDto? record;
    private List<DocumentationFieldValueInputDto> values = [];
    private string? message;
    private bool canCorrectCompleted;
    private bool canViewHistory;
    private bool isConflict;

    private bool IsFormReadOnly => record is null || record.Record.Status != DocumentationRecordStatus.Draft || !record.Actions.CanSaveDraft;

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task SaveDraftAsync()
    {
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationEdit))
        {
            message = "لا تملك صلاحية تعديل سجلات التوثيق.";
            return;
        }

        if (record is null || !record.Actions.CanSaveDraft)
        {
            message = record?.Actions.DraftEditBlockedReason is null
                ? "حفظ المسودة غير متاح حالياً."
                : LocalizeMessage(record.Actions.DraftEditBlockedReason);
            return;
        }

        var result = await SaveDraftUseCase.SaveDocumentationDraft(new SaveDocumentationDraftRequest(RecordId, record.Record.ConcurrencyToken, values));
        message = FormatResult(result);
        isConflict = result.ConcurrencyConflict;
        if (result.Succeeded)
        {
            await ReloadAsync();
        }
    }

    private async Task CompleteAsync()
    {
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationEdit) || !await IsAuthorizedAsync(PermissionNames.DocumentationComplete))
        {
            message = "لا تملك صلاحية إكمال سجلات التوثيق.";
            return;
        }

        if (record is null || !record.Actions.CanComplete)
        {
            message = record?.Actions.CompleteBlockedReason is null
                ? "إكمال التوثيق غير متاح حالياً."
                : LocalizeMessage(record.Actions.CompleteBlockedReason);
            return;
        }

        var result = await CompleteUseCase.CompleteDocumentationRecord(new CompleteDocumentationRecordRequest(RecordId, record.Record.ConcurrencyToken, values));
        message = FormatResult(result);
        isConflict = result.ConcurrencyConflict;
        if (result.Succeeded)
        {
            await ReloadAsync();
        }
    }

    private async Task ReloadLatestRecordAsync()
    {
        if (await ReloadAsync())
        {
            message = "تم تحميل أحدث نسخة. راجع البيانات قبل المتابعة.";
            isConflict = false;
        }
    }

    private async Task<bool> ReloadAsync()
    {
        canCorrectCompleted = await IsAuthorizedAsync(PermissionNames.DocumentationEdit);
        canViewHistory = await IsAuthorizedAsync(PermissionNames.DocumentationHistoryView);
        var permissions = await GetPermissionsAsync();
        var result = await GetRecordUseCase.GetDocumentationRecordForEdit(new GetDocumentationRecordForEditRequest(RecordId, permissions));
        if (!result.Succeeded)
        {
            message = FormatResult(result);
            isConflict = result.ConcurrencyConflict;
            return false;
        }

        record = result.Value!;
        values = ToInputs(record.Values);
        isConflict = false;
        return true;
    }

    private async Task<DocumentationActionPermissionSet> GetPermissionsAsync() => new(
        await IsAuthorizedAsync(PermissionNames.DocumentationCreate),
        await IsAuthorizedAsync(PermissionNames.DocumentationEdit),
        await IsAuthorizedAsync(PermissionNames.DocumentationComplete));

    private async Task<bool> IsAuthorizedAsync(string policy)
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return (await AuthorizationService.AuthorizeAsync(state.User, policy)).Succeeded;
    }

    private static List<DocumentationFieldValueInputDto> ToInputs(IReadOnlyList<DocumentationFieldValueDto> source) =>
        source.Select(value => new DocumentationFieldValueInputDto
        {
            FieldKey = value.FieldKey,
            TextValue = value.TextValue,
            NumberValue = value.NumberValue,
            DateValue = value.DateValue,
            BooleanValue = value.BooleanValue,
            OptionKey = value.OptionKey,
            OptionKeys = value.OptionKeys.ToList()
        }).ToList();

    private static string RecordStatusText(DocumentationRecordStatus status) => status switch
    {
        DocumentationRecordStatus.Draft => "مسودة",
        DocumentationRecordStatus.Completed => "مكتمل",
        _ => status.ToString()
    };

    private static string FormatResult<T>(UseCaseResult<T> result) =>
        result.Succeeded
            ? string.Join(" ", result.Messages.DefaultIfEmpty("تم الحفظ.").Select(LocalizeMessage))
            : result.ConcurrencyConflict
                ? string.Join(" ", result.Messages.Select(LocalizeMessage))
                : string.Join(" ", result.ValidationIssues.Select(issue => LocalizeMessage(issue.Message)));

    private static string LocalizeMessage(string message)
    {
        if (message.Contains("Draft documentation saved", StringComparison.OrdinalIgnoreCase)) return "تم حفظ المسودة.";
        if (message.Contains("documentation record completed", StringComparison.OrdinalIgnoreCase)) return "تم إكمال التوثيق.";
        if (message.Contains("Reload and review", StringComparison.OrdinalIgnoreCase)) return "تغيرت البيانات بواسطة مستخدم آخر. أعد تحميل أحدث نسخة وراجعها قبل المتابعة.";
        if (message.Contains("Only Draft", StringComparison.OrdinalIgnoreCase)) return "يمكن حفظ سجلات المسودة فقط.";
        if (message.Contains("required", StringComparison.OrdinalIgnoreCase)) return "توجد حقول مطلوبة لم تكتمل.";
        if (message.Contains("not authorized", StringComparison.OrdinalIgnoreCase)) return "لا تملك الصلاحية المطلوبة.";
        if (message.Contains("Saved", StringComparison.OrdinalIgnoreCase)) return "تم الحفظ.";
        return message;
    }
}
