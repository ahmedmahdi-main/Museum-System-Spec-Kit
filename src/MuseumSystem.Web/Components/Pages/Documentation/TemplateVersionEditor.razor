@page "/documentation/templates/{VersionId:guid}/edit"
@attribute [Authorize(Policy = PermissionNames.DocumentationTemplatesManage)]
@rendermode InteractiveServer
@inject TemplateQueryUseCases TemplateQueries
@inject SaveTemplateVersionDraftUseCase SaveDraftUseCase
@inject ActivateTemplateVersionUseCase ActivateUseCase
@inject NavigationManager Navigation
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>تحرير مسودة القالب</PageTitle>

<section class="page-header">
    <p class="eyebrow">قوالب التوثيق</p>
    <h1>تحرير مسودة القالب</h1>
</section>

<section class="page-section">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-message">@message</div>
    }

    @if (version is not null)
    {
        <div class="summary-grid">
            <div class="summary-item"><span>الفئة</span><strong>@version.ArtifactCategoryCode - @version.ArtifactCategoryName</strong></div>
            <div class="summary-item"><span>القالب</span><strong>@version.TemplateName</strong></div>
            <div class="summary-item"><span>الإصدار</span><strong>@version.VersionNumber</strong></div>
            <div class="summary-item"><span>الحالة</span><strong>@VersionStatusText(version.Status)</strong></div>
        </div>

        @if (version.IsReadOnly)
        {
            <div class="status-message">الإصدارات المستخدمة أو غير المسودة للقراءة فقط. أنشئ مسودة جديدة لتعديل الحقول أو الخيارات.</div>
            <a class="btn-secondary" href="@DetailsHref">عرض التفاصيل</a>
        }
        else
        {
            <EditForm Model="this" OnSubmit="SaveAsync" FormName="save-template-version-draft">
                <div class="form-actions">
                    <button type="button" class="btn-secondary" @onclick="AddField">إضافة حقل</button>
                    <button type="submit" class="btn-primary">حفظ المسودة</button>
                    <button type="button" class="btn-secondary" @onclick="ActivateAsync">تفعيل المسودة</button>
                </div>

                @foreach (var field in fields)
                {
                    <section class="field-card">
                        <div class="form-grid">
                            <label>
                                <span>مفتاح الحقل</span>
                                <InputText @bind-Value="field.FieldKey" class="form-control" />
                            </label>
                            <label>
                                <span>التسمية</span>
                                <InputText @bind-Value="field.Label" class="form-control" />
                            </label>
                            <label>
                                <span>نوع الحقل</span>
                                <InputSelect @bind-Value="field.FieldType" class="form-control">
                                    @foreach (var fieldType in supportedFieldTypes)
                                    {
                                        <option value="@fieldType">@FieldTypeText(fieldType)</option>
                                    }
                                </InputSelect>
                            </label>
                            <label>
                                <span>ترتيب العرض</span>
                                <InputNumber @bind-Value="field.DisplayOrder" class="form-control" />
                            </label>
                            <label>
                                <span>القسم</span>
                                <InputText @bind-Value="field.Section" class="form-control" />
                            </label>
                            <label>
                                <span>نص المساعدة</span>
                                <InputText @bind-Value="field.HelpText" class="form-control" />
                            </label>
                            <label class="checkbox-row">
                                <InputCheckbox @bind-Value="field.IsRequired" />
                                <span>مطلوب</span>
                            </label>
                            <div class="form-actions">
                                <button type="button" class="btn-secondary" @onclick="() => RemoveField(field)">حذف الحقل</button>
                            </div>
                        </div>

                        @if (IsSelect(field.FieldType))
                        {
                            <div class="table-wrap">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>مفتاح الخيار</th>
                                            <th>التسمية</th>
                                            <th>الترتيب</th>
                                            <th>إجراء</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var option in field.Options)
                                        {
                                            <tr>
                                                <td><InputText @bind-Value="option.OptionKey" class="form-control" /></td>
                                                <td><InputText @bind-Value="option.Label" class="form-control" /></td>
                                                <td><InputNumber @bind-Value="option.DisplayOrder" class="form-control" /></td>
                                                <td><button type="button" class="btn-secondary" @onclick="() => field.Options.Remove(option)">حذف</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <button type="button" class="btn-secondary" @onclick="() => AddOption(field)">إضافة خيار</button>
                        }
                    </section>
                }
            </EditForm>
        }
    }
</section>

@code {
    [Parameter] public Guid VersionId { get; set; }

    private static readonly DocumentationFieldType[] supportedFieldTypes = Enum.GetValues<DocumentationFieldType>();

    private DocumentationTemplateVersionDetailsDto? version;
    private List<FieldEditorModel> fields = [];
    private string? message;

    private string DetailsHref => $"documentation/templates/{VersionId}";

    protected override async Task OnParametersSetAsync() => await ReloadAsync();

    private async Task SaveAsync()
    {
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationTemplatesManage))
        {
            message = "لا تملك صلاحية إدارة قوالب التوثيق.";
            return;
        }

        if (version is null)
        {
            return;
        }

        var result = await SaveDraftUseCase.SaveTemplateVersionDraft(new SaveTemplateVersionDraftRequest(
            VersionId,
            version.ConcurrencyToken,
            fields.Select(field => new DocumentationTemplateFieldInputDto(
                field.FieldKey,
                field.Label,
                field.FieldType,
                field.IsRequired,
                field.DisplayOrder,
                field.Section,
                field.HelpText,
                IsSelect(field.FieldType)
                    ? field.Options.Select(option => new DocumentationTemplateFieldOptionInputDto(option.OptionKey, option.Label, option.DisplayOrder)).ToList()
                    : [])).ToList()));

        message = FormatResult(result);
        if (result.Succeeded)
        {
            await ReloadAsync();
        }
    }

    private async Task ActivateAsync()
    {
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationTemplatesManage))
        {
            message = "لا تملك صلاحية تفعيل قوالب التوثيق.";
            return;
        }

        if (version is null)
        {
            return;
        }

        var result = await ActivateUseCase.ActivateTemplateVersion(new ActivateTemplateVersionRequest(VersionId, version.ConcurrencyToken));
        message = FormatResult(result);
        if (result.Succeeded)
        {
            Navigation.NavigateTo($"documentation/templates/{VersionId}");
        }
    }

    private async Task ReloadAsync()
    {
        var result = await TemplateQueries.ViewTemplateVersion(VersionId);
        if (!result.Succeeded)
        {
            message = string.Join(" ", result.ValidationIssues.Select(issue => LocalizeMessage(issue.Message)));
            return;
        }

        version = result.Value!;
        fields = version.Fields.Select(field => new FieldEditorModel
        {
            FieldKey = field.FieldKey,
            Label = field.Label,
            FieldType = field.FieldType,
            IsRequired = field.IsRequired,
            DisplayOrder = field.DisplayOrder,
            Section = field.Section,
            HelpText = field.HelpText,
            Options = field.Options.Select(option => new OptionEditorModel
            {
                OptionKey = option.OptionKey,
                Label = option.Label,
                DisplayOrder = option.DisplayOrder
            }).ToList()
        }).ToList();
    }

    private void AddField()
    {
        fields.Add(new FieldEditorModel
        {
            FieldKey = $"field_{fields.Count + 1}",
            Label = "حقل جديد",
            FieldType = DocumentationFieldType.Text,
            DisplayOrder = fields.Count == 0 ? 1 : fields.Max(field => field.DisplayOrder) + 1,
            Section = "الرئيسية"
        });
    }

    private static void AddOption(FieldEditorModel field)
    {
        field.Options.Add(new OptionEditorModel
        {
            OptionKey = $"option_{field.Options.Count + 1}",
            Label = "خيار جديد",
            DisplayOrder = field.Options.Count == 0 ? 1 : field.Options.Max(option => option.DisplayOrder) + 1
        });
    }

    private void RemoveField(FieldEditorModel field) => fields.Remove(field);

    private async Task<bool> IsAuthorizedAsync(string policy)
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return (await AuthorizationService.AuthorizeAsync(state.User, policy)).Succeeded;
    }

    private static bool IsSelect(DocumentationFieldType fieldType) =>
        fieldType is DocumentationFieldType.SingleSelect or DocumentationFieldType.MultiSelect;

    private static string FieldTypeText(DocumentationFieldType fieldType) => fieldType switch
    {
        DocumentationFieldType.Text => "نص قصير",
        DocumentationFieldType.MultilineText => "نص متعدد الأسطر",
        DocumentationFieldType.Number => "رقم",
        DocumentationFieldType.Date => "تاريخ",
        DocumentationFieldType.Boolean => "نعم / لا",
        DocumentationFieldType.SingleSelect => "اختيار واحد",
        DocumentationFieldType.MultiSelect => "اختيارات متعددة",
        _ => fieldType.ToString()
    };

    private static string VersionStatusText(DocumentationTemplateVersionStatus status) => status switch
    {
        DocumentationTemplateVersionStatus.Draft => "مسودة",
        DocumentationTemplateVersionStatus.Active => "نشط",
        DocumentationTemplateVersionStatus.Retired => "متوقف",
        _ => status.ToString()
    };

    private static string FormatResult<T>(UseCaseResult<T> result) =>
        result.Succeeded
            ? string.Join(" ", result.Messages.DefaultIfEmpty("تم الحفظ.").Select(LocalizeMessage))
            : result.ConcurrencyConflict
                ? string.Join(" ", result.Messages.Select(LocalizeMessage))
                : string.Join(" ", result.ValidationIssues.Select(issue => LocalizeMessage(issue.Message)));

    private static string LocalizeMessage(string message)
    {
        if (message.Contains("saved", StringComparison.OrdinalIgnoreCase)) return "تم حفظ المسودة.";
        if (message.Contains("activated", StringComparison.OrdinalIgnoreCase)) return "تم تفعيل المسودة.";
        if (message.Contains("Reload and review", StringComparison.OrdinalIgnoreCase)) return "تغيرت البيانات. أعد التحميل وراجع آخر نسخة قبل المتابعة.";
        if (message.Contains("Only Draft", StringComparison.OrdinalIgnoreCase)) return "يمكن تحرير إصدارات المسودة فقط.";
        if (message.Contains("not authorized", StringComparison.OrdinalIgnoreCase)) return "لا تملك الصلاحية المطلوبة.";
        return message;
    }

    private sealed class FieldEditorModel
    {
        public string FieldKey { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public DocumentationFieldType FieldType { get; set; } = DocumentationFieldType.Text;
        public bool IsRequired { get; set; }
        public int DisplayOrder { get; set; } = 1;
        public string Section { get; set; } = "الرئيسية";
        public string? HelpText { get; set; }
        public List<OptionEditorModel> Options { get; set; } = [];
    }

    private sealed class OptionEditorModel
    {
        public string OptionKey { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public int DisplayOrder { get; set; } = 1;
    }
}
