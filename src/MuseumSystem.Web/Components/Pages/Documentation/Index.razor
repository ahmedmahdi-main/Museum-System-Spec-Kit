@page "/documentation"
@attribute [Authorize(Policy = PermissionNames.DocumentationView)]
@rendermode InteractiveServer
@inject SearchDocumentationArtifactUseCase SearchUseCase
@inject CreateDocumentationRecordUseCase CreateUseCase
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>توثيق القطع</PageTitle>

<section class="page-header">
    <p class="eyebrow">التوثيق</p>
    <h1>توثيق القطع</h1>
    <p>ابحث برقم المتحف لفتح مساحة التوثيق الخاصة بالقطعة.</p>
</section>

<section class="page-section">
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="status-message @(isConflict ? "warning-message" : null)">@message</div>
        @if (isConflict)
        {
            <div class="form-actions">
                <button type="button" class="btn-secondary" @onclick="ReloadLatestWorkspaceAsync">إعادة تحميل أحدث نسخة</button>
            </div>
        }
    }

    <EditForm Model="this" OnSubmit="SearchAsync" FormName="documentation-artifact-search">
        <div class="search-row">
            <label>
                <span>رقم المتحف</span>
                <InputText @bind-Value="museumNumber" class="form-control" autofocus />
            </label>
            <button type="submit" class="btn-primary">بحث</button>
        </div>
    </EditForm>
</section>

@if (workspace is not null)
{
    <section class="page-section">
        <div>
            <p class="eyebrow">نتيجة البحث</p>
            <h2>@workspace.Artifact.MuseumNumber</h2>
        </div>

        <div class="summary-grid">
            <div class="summary-item">
                <span>الوصف</span>
                <strong>@workspace.Artifact.BasicDescription</strong>
            </div>
            <div class="summary-item">
                <span>الفئة</span>
                <strong>@workspace.Artifact.CategoryCode - @workspace.Artifact.CategoryName</strong>
            </div>
            <div class="summary-item">
                <span>الحيازة الحالية</span>
                <strong>@CustodyText(workspace.Artifact)</strong>
            </div>
            <div class="summary-item">
                <span>حالة التوثيق</span>
                <strong>@DocumentationStatusText(workspace.DocumentationStatus)</strong>
            </div>
            <div class="summary-item">
                <span>القالب النشط</span>
                <strong>@(workspace.ActiveTemplateVersion is null ? "لا يوجد قالب نشط" : $"الإصدار {workspace.ActiveTemplateVersion.VersionNumber}")</strong>
            </div>
            <div class="summary-item">
                <span>إتاحة التوثيق</span>
                <strong>@(workspace.Artifact.IsAvailableToDocumentation ? "القطعة لدى التوثيق" : "القطعة ليست لدى التوثيق")</strong>
            </div>
        </div>

        @if (workspace.ExistingRecord is null)
        {
            <div class="card-panel">
                <h3>لا يوجد سجل توثيق</h3>
                <p class="muted">يمكن إنشاء سجل توثيق عندما يوجد قالب توثيق نشط لفئة القطعة.</p>
                @if (workspace.Actions.CanCreate)
                {
                    <button type="button" class="btn-primary" @onclick="CreateAsync">إنشاء سجل توثيق</button>
                }
                else if (workspace.ActiveTemplateVersion is null)
                {
                    <p class="muted">لا يوجد قالب توثيق نشط لهذه الفئة.</p>
                }
                else if (!string.IsNullOrWhiteSpace(workspace.Actions.CreateBlockedReason))
                {
                    <p class="muted">@LocalizeMessage(workspace.Actions.CreateBlockedReason)</p>
                }
            </div>
        }
        else if (workspace.ExistingRecord.Status == DocumentationRecordStatus.Draft)
        {
            <div class="card-panel">
                <h3>مسودة توثيق</h3>
                <p class="muted">يوجد سجل توثيق محفوظ كمسودة.</p>
                @if (workspace.Actions.CanResumeDraft)
                {
                    <a class="btn-primary" href="@EditHref(workspace.ExistingRecord.DocumentationRecordId)">متابعة المسودة</a>
                }
                else if (!string.IsNullOrWhiteSpace(workspace.Actions.DraftEditBlockedReason))
                {
                    <p class="muted">@LocalizeMessage(workspace.Actions.DraftEditBlockedReason)</p>
                }
            </div>
        }
        else if (workspace.ExistingRecord.Status == DocumentationRecordStatus.Completed)
        {
            <div class="card-panel">
                <h3>توثيق مكتمل</h3>
                <p class="muted">السجل مكتمل ومتاح للعرض في هذه المرحلة.</p>
                @if (workspace.Actions.CanViewCompleted)
                {
                    <a class="btn-secondary" href="@EditHref(workspace.ExistingRecord.DocumentationRecordId)">عرض التوثيق</a>
                }
            </div>
        }
    </section>
}

@code {
    private string museumNumber = string.Empty;
    private string? message;
    private DocumentationWorkspaceDto? workspace;
    private bool isConflict;

    private async Task SearchAsync() => await RefreshWorkspaceAsync(clearMessage: true);

    private async Task RefreshWorkspaceAsync(bool clearMessage)
    {
        if (clearMessage)
        {
            message = null;
            isConflict = false;
        }

        var permissions = await GetPermissionsAsync();
        var result = await SearchUseCase.SearchDocumentationArtifact(new SearchDocumentationArtifactRequest(museumNumber, permissions));
        if (!result.Succeeded)
        {
            workspace = null;
            if (clearMessage)
            {
                message = FormatResult(result);
                isConflict = result.ConcurrencyConflict;
            }
            return;
        }

        workspace = result.Value;
    }

    private async Task ReloadLatestWorkspaceAsync()
    {
        await RefreshWorkspaceAsync(clearMessage: true);
        if (workspace is not null)
        {
            message = "تم تحميل أحدث نسخة. راجع البيانات قبل المتابعة.";
            isConflict = false;
        }
    }

    private async Task CreateAsync()
    {
        isConflict = false;
        if (!await IsAuthorizedAsync(PermissionNames.DocumentationCreate))
        {
            message = "لا تملك صلاحية إنشاء سجلات التوثيق.";
            return;
        }

        if (workspace is null || !workspace.Actions.CanCreate)
        {
            message = workspace?.Actions.CreateBlockedReason is null
                ? "إنشاء سجل التوثيق غير متاح حالياً."
                : LocalizeMessage(workspace.Actions.CreateBlockedReason);
            return;
        }

        var result = await CreateUseCase.CreateDocumentationRecord(new CreateDocumentationRecordRequest(workspace.Artifact.ArtifactId));
        if (!result.Succeeded)
        {
            var failureMessage = FormatResult(result);
            var conflict = result.ConcurrencyConflict;
            await RefreshWorkspaceAsync(clearMessage: false);
            message = failureMessage;
            isConflict = conflict;
            return;
        }

        message = FormatResult(result);
        isConflict = false;
        Navigation.NavigateTo(EditHref(result.Value!.Record.DocumentationRecordId));
    }

    private async Task<DocumentationActionPermissionSet> GetPermissionsAsync() => new(
        await IsAuthorizedAsync(PermissionNames.DocumentationCreate),
        await IsAuthorizedAsync(PermissionNames.DocumentationEdit),
        await IsAuthorizedAsync(PermissionNames.DocumentationComplete));

    private async Task<bool> IsAuthorizedAsync(string policy)
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return (await AuthorizationService.AuthorizeAsync(state.User, policy)).Succeeded;
    }

    private static string EditHref(Guid recordId) => $"documentation/records/{recordId}/edit";

    private static string CustodyText(DocumentationArtifactSummaryDto artifact) =>
        artifact.CurrentStatus == ArtifactCurrentStatus.InStorage
            ? artifact.CurrentLocationName ?? "داخل الخزن"
            : artifact.CurrentHolderName ?? HolderTypeText(artifact.CurrentHolderType) ?? "خارج الخزن";

    private static string? HolderTypeText(string? holderType) => holderType switch
    {
        "DocumentationDivision" => "قسم التوثيق",
        "ConservationLab" => "المختبر",
        "PhotographyUnit" => "وحدة التصوير",
        "DisplayHall" => "قاعة العرض",
        _ => holderType
    };

    private static string DocumentationStatusText(DocumentationArtifactDocumentationStatus status) => status switch
    {
        DocumentationArtifactDocumentationStatus.None => "لا يوجد سجل",
        DocumentationArtifactDocumentationStatus.Draft => "مسودة",
        DocumentationArtifactDocumentationStatus.Completed => "مكتمل",
        _ => status.ToString()
    };

    private static string FormatResult<T>(UseCaseResult<T> result) =>
        result.Succeeded
            ? string.Join(" ", result.Messages.DefaultIfEmpty("تم الحفظ.").Select(LocalizeMessage))
            : result.ConcurrencyConflict
                ? string.Join(" ", result.Messages.Select(LocalizeMessage))
                : string.Join(" ", result.ValidationIssues.Select(issue => LocalizeMessage(issue.Message)));

    private static string LocalizeMessage(string message)
    {
        if (message.Contains("Artifact was not found", StringComparison.OrdinalIgnoreCase)) return "لم يتم العثور على القطعة.";
        if (message.Contains("already has a Documentation Record", StringComparison.OrdinalIgnoreCase)) return "توجد للقطعة سجل توثيق مسبق.";
        if (message.Contains("No Active documentation template", StringComparison.OrdinalIgnoreCase)) return "لا يوجد قالب توثيق نشط لهذه الفئة.";
        if (message.Contains("Draft documentation record created", StringComparison.OrdinalIgnoreCase)) return "تم إنشاء مسودة التوثيق.";
        if (message.Contains("Reload and review", StringComparison.OrdinalIgnoreCase)) return "تغيرت البيانات بواسطة مستخدم آخر. أعد تحميل أحدث نسخة وراجعها قبل المتابعة.";
        if (message.Contains("not authorized", StringComparison.OrdinalIgnoreCase)) return "لا تملك الصلاحية المطلوبة.";
        if (message.Contains("Saved", StringComparison.OrdinalIgnoreCase)) return "تم الحفظ.";
        return message;
    }
}
