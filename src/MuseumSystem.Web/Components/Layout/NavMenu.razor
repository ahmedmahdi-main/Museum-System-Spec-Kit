@* Labels here match each page's own heading, so a link and the page it opens are named the same thing. *@
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider
<nav class="nav-menu" aria-label="قائمة النظام">
    <div class="nav-group nav-home">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">الرئيسية</NavLink>
    </div>

    <div class="nav-group">
        <AuthorizeView Policy="@PermissionNames.ArtifactsView">
            <Authorized>
                <div class="nav-section">سجل القطع</div>
                <NavLink class="nav-link" href="artifacts" Match="NavLinkMatch.All">البحث عن القطع</NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@PermissionNames.ArtifactsManage">
            <Authorized>
                <NavLink class="nav-link" href="artifacts/create" Match="NavLinkMatch.All">إنشاء قطعة</NavLink>
                <NavLink class="nav-link" href="artifacts/categories" Match="NavLinkMatch.All">إدارة الفئات</NavLink>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="nav-group">
        <AuthorizeView Policy="@PermissionNames.StorehouseDeliver">
            <Authorized>
                <div class="nav-section">المخزن والحركة</div>
                <NavLink class="nav-link" href="storehouse/delivery" Match="NavLinkMatch.All">تسليم القطع</NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@PermissionNames.StorehouseReturn">
            <Authorized>
                <NavLink class="nav-link" href="storehouse/return" Match="NavLinkMatch.All">استلام القطع</NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@PermissionNames.StorehouseLocationsManage">
            <Authorized>
                <NavLink class="nav-link" href="storehouse/locations" Match="NavLinkMatch.All">مواقع الخزن والعرض</NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@PermissionNames.StorehouseReconciliationManage">
            <Authorized>
                <NavLink class="nav-link" href="storehouse/reconciliation" Match="NavLinkMatch.All">الجرد</NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@PermissionNames.StorehouseCorrectionsCreate">
            <Authorized>
                <NavLink class="nav-link" href="storehouse/documented-correction" Match="NavLinkMatch.All">تصحيح موثق</NavLink>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="nav-group">
        <AuthorizeView Policy="@PermissionNames.ImportsPreview">
            <Authorized>
                <div class="nav-section">الاستيراد</div>
                <NavLink class="nav-link" href="imports/excel" Match="NavLinkMatch.All">استيراد Excel</NavLink>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="nav-group">
        <AuthorizeView Policy="@PermissionNames.DocumentationView">
            <Authorized>
                <div class="nav-section">التوثيق</div>
                <NavLink class="nav-link" href="documentation" Match="NavLinkMatch.All">توثيق القطع</NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@PermissionNames.DocumentationTemplatesView">
            <Authorized>
                <NavLink class="nav-link" href="documentation/templates" Match="NavLinkMatch.All">قوالب التوثيق</NavLink>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="nav-group">
        @if (canUploadPhotography || canUsePhotographyRequests)
        {
            <div class="nav-section">التصوير</div>
            @if (canUploadPhotography)
            {
                <NavLink class="nav-link" href="photography/upload" Match="NavLinkMatch.All">رفع صور القطعة</NavLink>
            }
            @if (canUsePhotographyRequests)
            {
                <NavLink class="nav-link" href="photography/requests" Match="NavLinkMatch.All">طلبات التصوير</NavLink>
            }
        }
    </div>

    <div class="nav-group">
        <AuthorizeView Policy="@PermissionNames.AuditView">
            <Authorized>
                <div class="nav-section">الإدارة</div>
                <NavLink class="nav-link" href="admin/audit" Match="NavLinkMatch.All">سجل التدقيق</NavLink>
            </Authorized>
        </AuthorizeView>
    </div>
</nav>
@code {
    private bool canUploadPhotography;
    private bool canUsePhotographyRequests;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        canUploadPhotography = await IsAuthorizedAsync(state, PermissionNames.PhotographyUpload);
        canUsePhotographyRequests =
            await IsAuthorizedAsync(state, PermissionNames.PhotographyRequest)
            || await IsAuthorizedAsync(state, PermissionNames.PhotographyManage)
            || canUploadPhotography;
    }

    private async Task<bool> IsAuthorizedAsync(AuthenticationState state, string policy) =>
        (await AuthorizationService.AuthorizeAsync(state.User, policy)).Succeeded;
}
