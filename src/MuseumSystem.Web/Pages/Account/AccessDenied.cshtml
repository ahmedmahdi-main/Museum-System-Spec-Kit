@page "/Account/AccessDenied"
@attribute [AllowAnonymous]
@{
    Layout = null;
    ViewData["Title"] = "غير مصرح";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام إدارة المتحف العراقي</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="stylesheet" href="/app.css" />
</head>
<body>
    <main class="auth-page">
        <section class="auth-card">
            <div class="auth-brand">
                <strong>نظام إدارة المتحف العراقي</strong>
                <span>صلاحيات الوصول</span>
            </div>
            <h1>غير مصرح</h1>
            <p class="muted">حسابك لا يملك صلاحية فتح هذه الصفحة. راجع إدارة النظام إذا كانت مطلوبة لعملك.</p>
            <a class="btn-primary" href="/">العودة للرئيسية</a>
        </section>
    </main>
</body>
</html>
