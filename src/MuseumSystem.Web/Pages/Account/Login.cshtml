@page "/Account/Login"
@model MuseumSystem.Web.Pages.Account.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "تسجيل الدخول";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام مخزن المتحف</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <link rel="stylesheet" href="/app.css" />
</head>
<body>
    <main class="auth-page auth-page-login">
        <section class="auth-context" aria-labelledby="auth-system-title">
            <p class="page-kicker">نظام مخزن المتحف</p>
            <h1 id="auth-system-title">دخول موظفي السجل والمخزن</h1>
            <p>واجهة تشغيلية لإدارة أرقام المتحف، مواقع الخزن، الحيازة، حركة القطع، والتوثيق المؤسسي.</p>
        </section>

        <section class="auth-card" aria-labelledby="login-title">
            <div class="auth-brand">
                <strong>نظام مخزن المتحف</strong>
                <span>دخول مصرح للموظفين</span>
            </div>
            <h1 id="login-title">تسجيل الدخول</h1>
            <p class="muted">استخدم حسابك للوصول إلى وظائف السجل والمخزن حسب الصلاحيات الممنوحة لك.</p>

            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <label>
                    <span>اسم المستخدم</span>
                    <input asp-for="Input.Username" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                </label>

                <label>
                    <span>كلمة المرور</span>
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </label>

                <div class="action-bar">
                    <span class="action-bar-note">الجلسة مرتبطة بصلاحياتك المؤسسية.</span>
                    <button type="submit" class="btn-primary">تسجيل الدخول</button>
                </div>
            </form>
        </section>
    </main>
</body>
</html>
